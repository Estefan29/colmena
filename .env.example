# Conexión a la base de datos Postgres. En Vercel, si agregas un almacenamiento
# Postgres desde la pestaña "Storage" del proyecto, esta variable se crea sola.
# En local, apunta a un Postgres que tengas corriendo (o a uno gratis de Neon/Supabase).
DATABASE_URL=postgres://usuario:password@host:5432/nombre_basedatos

# Contraseña compartida para las empleadas (cámbiala)
EMPLOYEE_PASSWORD=empleada123

# Contraseña para la dueña (cámbiala)
OWNER_PASSWORD=duena123

# Frase secreta usada para firmar la sesión de inicio de sesión. Usa algo largo y aleatorio.
AUTH_SECRET=cambia-esto-por-algo-largo-y-aleatorio
